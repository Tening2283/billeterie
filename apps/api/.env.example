# Copier ce fichier en .env (dev) et .env.test (tests), jamais versionnés, puis adapter.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origines autorisées (CORS + Socket.io), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# Neon, URL « pooled » (hôte en -pooler) : utilisée par l'appli via le pilote pg.
# sslmode=verify-full : c'est déjà ce que pg fait avec « require », écrit explicitement.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
# Neon, URL directe (sans -pooler) : utilisée par le CLI Prisma pour les migrations (prisma.config.ts).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Secret des jetons JWT : au moins 32 caractères aléatoires, différent par environnement.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="remplacer-par-un-secret-aleatoire-d-au-moins-32-caracteres"
# Coût bcrypt : 12 par défaut ; mettre 4 dans .env.test pour des tests rapides.
# BCRYPT_COST=12

# Redis : Upstash (rediss://, TLS) ou redis://localhost:6379 (Memurai). Pas l'URL REST (https://).
REDIS_URL="rediss://default:PASSWORD@xxx.upstash.io:6379"
# Préfixe des clés : isole dev:, test: et prod: s'ils partagent une même base Redis.
REDIS_KEY_PREFIX="dev:"
# Durée d'un blocage de place (ms), 10 min par défaut.
# HOLD_TTL_MS=600000

# Secret HMAC des codes de billets (QR) : 32 caractères minimum, différent de JWT_SECRET
# et différent par environnement (un billet signé en test ne doit pas passer en prod).
TICKET_SECRET="remplacer-par-un-autre-secret-aleatoire-d-au-moins-32-caracteres"
