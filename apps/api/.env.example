# Copier ce fichier en .env (jamais versionné) et adapter.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Origines autorisées (CORS + Socket.io), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# Étapes suivantes :
# DATABASE_URL=postgresql://...   (Neon, URL « pooled »)
# DIRECT_URL=postgresql://...     (Neon, URL directe, pour les migrations)
# REDIS_URL=rediss://...          (Upstash) ou redis://localhost:6379 (Memurai)
# JWT_SECRET=...                  (au moins 32 caractères aléatoires)
# TICKET_SECRET=...               (différent par environnement)
